# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mhs:mhs@localhost:5432/mhs
DATABASE_URL_SYNC=postgresql://mhs:mhs@localhost:5432/mhs

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j (optional — not required for Pre-MVP) ───────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mhs_neo4j_password

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── External APIs ─────────────────────────────────────────────────────────────
CLIMATIQ_API_KEY=
ANGEL_AI_MODEL=llama3.3-70b
ANTHROPIC_API_KEY=

# ── OAuth providers ───────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── PostgreSQL (used by docker-compose) ───────────────────────────────────────
POSTGRES_USER=mhs
POSTGRES_PASSWORD=mhs
POSTGRES_DB=mhs
